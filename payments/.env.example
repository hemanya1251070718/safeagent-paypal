PORT=5000
NODE_ENV=development

# PayPal Developer Sandbox / Live Credentials
# Leave PAYPAL_CLIENT_ID and PAYPAL_CLIENT_SECRET empty (or placeholder) for simulation mode
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_sandbox_secret_here
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Webhook signature verification (leave empty or placeholder to run webhook in simulation mode)
PAYPAL_WEBHOOK_ID=your_webhook_id_here

# Tier 1 Vault Zero-Touch settlement
# When intent.total <= TIER1_LIMIT and PAYPAL_VAULT_ID is set, uses payment_source.paypal.vault_id
PAYPAL_VAULT_ID=your_vault_id_here
TIER1_LIMIT=2500

# Currency guard conversion rate for unsupported live currencies (e.g., INR -> USD)
INR_TO_USD=0.012

